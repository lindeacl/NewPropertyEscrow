# Environment Configuration Template for NewPropertyEscrow

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/newpropertyescrow
PGHOST=localhost
PGPORT=5432
PGUSER=your_username
PGPASSWORD=your_password
PGDATABASE=newpropertyescrow

# JWT Configuration
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Blockchain Configuration
ALCHEMY_API_KEY=your-alchemy-api-key
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-api-key
MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/your-api-key
CONTRACT_ADDRESS=your-deployed-contract-address
FACTORY_CONTRACT_ADDRESS=your-factory-contract-address

# Environment
ENVIRONMENT=development
